{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/generated/prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
